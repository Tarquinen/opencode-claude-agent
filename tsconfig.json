{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "noEmit": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["server.ts", "src", "test"]
}
