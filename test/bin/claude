#!/usr/bin/env bun
// The fake `claude` as a real program, for the packaging check (TESTING.md). Answers every start-up with the
// recorded reply, replays a text turn, and logs each process to $FAKE_CLAUDE_LOG.
import { appendFileSync } from "node:fs"
import { createInterface } from "node:readline"
import { FakeClaude } from "../lib/fake-claude.ts"

const startup = FakeClaude.expectStartup()
let initialize: any
let model: string | undefined
if (process.env.FAKE_CLAUDE_LOG)
  appendFileSync(process.env.FAKE_CLAUDE_LOG, JSON.stringify(process.argv.slice(2)) + "\n")

for await (const line of createInterface({ input: process.stdin })) {
  const message = JSON.parse(line)
  if (message.request?.subtype === "set_model") model = message.request.model
  const probe = FakeClaude.probeResponse(message, model)
  if (message.type === "control_request" && message.request.subtype === "initialize") {
    initialize = message.request
    process.stdout.write(JSON.stringify(FakeClaude.startupResponse(message.request_id, startup.reply)) + "\n")
  } else if (probe) {
    process.stdout.write(JSON.stringify(probe) + "\n")
  } else if (message.type === "user" || message.request?.subtype === "interrupt") {
    const step = message.type === "user" ? FakeClaude.expectTurn() : FakeClaude.expectInterrupt()
    for (const reply of FakeClaude.replies(step, message.request_id))
      process.stdout.write(JSON.stringify(FakeClaude.withTools(reply, initialize)) + "\n")
  }
}
